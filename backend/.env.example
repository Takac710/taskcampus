# Local dev default: SQLite. For production, use the Supabase Postgres
# connection string from Project Settings > Database > Connection string (URI).
DATABASE_URL=sqlite:///./taskcampus.db
# Project Settings > API > JWT Settings > "Legacy JWT Secret" (HS256).
# Without this, every request is rejected with 401 -- auth is real now, not a dev bypass.
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:3000

# Web Push reminders (M6, F-05). Generate a local key pair with:
#   .venv/bin/python scripts/generate_vapid_keys.py
# No external account needed. Without these, /push/vapid-public-key returns an
# empty key and push sends silently fail (logged, not raised).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
NOTIFY_INTERVAL_MINUTES=15
