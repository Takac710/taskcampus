# Local dev default: SQLite. For production, use the Supabase Postgres
# connection string from Project Settings > Database > Connection string (URI).
DATABASE_URL=sqlite:///./taskcampus.db
# Project Settings > API > Project URL. Required to verify tokens from
# newer Supabase projects, which sign with an asymmetric key (ES256) -- the
# backend fetches that project's public JWKS from here. Same value as the
# frontend's NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
# Only needed for older projects still using the legacy shared HS256 secret
# (Project Settings > API > JWT Settings > "Legacy JWT Secret"). Leave blank
# if your project uses the default asymmetric signing keys (SUPABASE_URL above).
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:3000

# Web Push reminders (M6, F-05). Generate a local key pair with:
#   .venv/bin/python scripts/generate_vapid_keys.py
# No external account needed. Without these, /push/vapid-public-key returns an
# empty key and push sends silently fail (logged, not raised).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
NOTIFY_INTERVAL_MINUTES=15
