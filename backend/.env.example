# Local dev default: SQLite. For production, use the Supabase Postgres
# connection string from Project Settings > Database > Connection string (URI).
DATABASE_URL=sqlite:///./taskcampus.db
# Project Settings > API > JWT Settings > "Legacy JWT Secret" (HS256).
# Without this, every request is rejected with 401 -- auth is real now, not a dev bypass.
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
